{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/api/app"
    }
  ],
  "redirects": [
    {
      "source": "/ios",
      "destination": "https://apps.apple.com/app/id6784545562?mt=8",
      "permanent": false
    },
    {
      "source": "/android",
      "destination": "https://play.google.com/store/apps/details?id=cloud.dreamscapes.app",
      "permanent": false
    }
  ]
}
