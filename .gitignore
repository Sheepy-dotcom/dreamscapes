.DS_Store
.vercel/
android/.idea/
android/keystore.properties
android/app/*.jks
android/app/*.keystore

# Apple private keys. One was sitting untracked in the project root and would
# have been committed by the next `git add -A`.
*.p8
dreamscapes-testers.csv
node_modules/
dist/
www/
ios/build/

# Release build artifacts
*.aab
*.apk
*.ipa

# Python bytecode from scripts/
__pycache__/

# Source material for the artwork, kept beside the project but never shipped:
# everything under assets/ is copied into both app bundles, and these are the
# originals the webp files in assets/ were made from.
/source-art/
/assets/app-illustrations/

# Throwaway clips from scripts/probe-audio-models.js - comparison material,
# not store assets.
store-assets/audio-probe/

# Secrets pulled down with `vercel env pull`. SUPABASE_SERVICE_ROLE_KEY lands
# in here, and it must never reach the repo.
.env
.env.*
!.env.example

# iCloud sync duplicates. The repo lives under ~/Documents, and iCloud
# resolves its own conflicts by writing "name 2.ext" beside the original.
# Android refuses to build when one lands in res/, so they must never be
# committed and are better deleted on sight.
*[ ][0-9].*
